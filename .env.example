# --- Auth (shared-password login for this internal tool) ---
APP_PASSWORD=
# Random string used to sign the session cookie. Generate with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# --- Shared secret between the Next.js backend and the Python compute function ---
# Required because Python serverless functions on Vercel are NOT covered by
# Next.js middleware, so this is what stops them being called directly by
# anyone who has the deployment URL. Generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=

# --- Vercel Blob (create a store in the Vercel dashboard -> Storage -> Blob, then connect
# it to this project; BLOB_READ_WRITE_TOKEN is set automatically once connected) ---
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (Vercel dashboard -> Storage -> Marketplace -> Upstash for Redis, then
# connect it to this project; these are set automatically once connected) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local-only storage fallback ---
# Set to "true" to skip needing real Blob/Redis while developing (writes to
# .local-data/ on disk instead). NEVER set this in a real deployment.
LOCAL_DEV_STORAGE=false

# --- Local development only ---
# When running the Next.js app and the Python function as two separate local
# processes (`next dev` + `uvicorn api.index:app --reload --port 8000`), point
# the Node side at the Python one. Leave unset when using `vercel dev`, which
# proxies both under one origin, or in production (VERCEL_URL is used instead).
PYTHON_API_BASE_URL=http://localhost:8000

# How long the cached feed slug map is reused before re-downloading (seconds). Default: 6h.
FEED_CACHE_TTL_SECONDS=21600
