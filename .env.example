# All settings are optional; the defaults work out of the box with `npm run local`.

# Where jobs, uploaded spreadsheets, result CSVs and the feed cache are stored.
# Shared by the Next.js app and the Python compute API. Default: ./.local-data
# Tip: point this outside a OneDrive-synced folder to avoid sync interference.
LOCAL_DATA_DIR=

# How long the downloaded feed is reused before it is fetched again (seconds). Default: 6h.
FEED_CACHE_TTL_SECONDS=21600

# Address of the Python compute API. Set automatically by scripts/start-local.mjs;
# only needed when running `next dev` and `uvicorn` by hand.
PYTHON_API_BASE_URL=http://127.0.0.1:8000
